# =============================================================================
# Jitsi Meet stack
# =============================================================================
# Every variable in this file is handed to every container through `env_file`.
# The compose file never enumerates variable names, so any variable supported
# by the Jitsi images works here -- including ones added or renamed in future
# releases.
#
# Copy to `.env` and edit. Run `scripts/gen-secrets.sh` to fill the secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Release
# -----------------------------------------------------------------------------

# Any `stable-*` tag published by the Jitsi project. This is the only place
# where the version is stated.
JITSI_VERSION=stable-11031

RESTART_POLICY=unless-stopped
TZ=UTC
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Public domains
# -----------------------------------------------------------------------------

# Comma-separated list of domains served by this instance. They share one room
# namespace: a room name resolves to the same room on every domain.
JITSI_DOMAINS=meet.example.org,team.meet.example.org

# Primary domain. Signalling (BOSH and WebSocket) always points here, whichever
# domain served the page.
PUBLIC_URL=https://meet.example.org


# -----------------------------------------------------------------------------
# TLS
# -----------------------------------------------------------------------------

# files          Use TLS_CERT_FILE and TLS_KEY_FILE as they are.
# acme-http      Issue with acme.sh over HTTP-01. No wildcards.
# acme-dns-azure Issue with acme.sh over DNS-01 against Azure DNS. Wildcards OK.
TLS_MODE=files

# Used when TLS_MODE=files. Paths inside conf/certs/.
TLS_CERT_FILE=/conf/certs/fullchain.pem
TLS_KEY_FILE=/conf/certs/privkey.pem

# Used by both ACME modes.
ACME_EMAIL=
# Domains to request, comma-separated. Defaults to JITSI_DOMAINS when empty.
# Wildcards are only valid with TLS_MODE=acme-dns-azure.
ACME_DOMAINS=

# Used by TLS_MODE=acme-dns-azure. The service principal needs the
# "DNS Zone Contributor" role on the zone. No resource group needed: acme.sh
# discovers the zone.
AZUREDNS_SUBSCRIPTIONID=
AZUREDNS_TENANTID=
AZUREDNS_APPID=
AZUREDNS_CLIENTSECRET=

# Additional CA to trust, for example when the room notification endpoint is
# signed by a private CA. Leave empty to trust only the public roots.
EXTRA_CA_FILE=

# Defaults reproduce the hardened settings of a standard Jitsi deployment.
NGINX_SSL_PROTOCOLS=TLSv1.3 TLSv1.2
NGINX_SSL_CIPHERS=ECDHE-ECDSA-AES128-GCM-SHA256 ECDHE-ECDSA-AES256-GCM-SHA384 ECDHE-ECDSA-AES128-SHA ECDHE-ECDSA-AES256-SHA ECDHE-ECDSA-AES128-SHA256 ECDHE-ECDSA-AES256-SHA384 ECDHE-RSA-AES128-GCM-SHA256 ECDHE-RSA-AES256-GCM-SHA384 ECDHE-RSA-AES128-SHA ECDHE-RSA-AES128-SHA256 ECDHE-RSA-AES256-SHA384 DHE-RSA-AES128-GCM-SHA256 DHE-RSA-AES256-GCM-SHA384 DHE-RSA-AES128-SHA DHE-RSA-AES256-SHA DHE-RSA-AES128-SHA256 DHE-RSA-AES256-SHA256
NGINX_HSTS_MAX_AGE=31536000

# Source addresses allowed to reach locations that include
# only-trusted-hosts.conf, comma or space separated. Accepts anything nginx's
# `allow` accepts: an address, a CIDR block, or `all`.
#
# Empty means nothing is trusted, and those locations deny everyone. That is
# deliberate: an allow-list with nothing allowed must not quietly become no
# restriction at all.
#
# For rules a flat list cannot express, put your own
# conf/nginx/snippets/only-trusted-hosts.conf in place and it is used instead.
TRUSTED_HOSTS=


# -----------------------------------------------------------------------------
# Prosody plugins
# -----------------------------------------------------------------------------

# Space-separated list of URLs. Each one is downloaded into
# conf/prosody/plugins/ on startup. A download that fails leaves the previously
# downloaded copy in place, so the stack still starts.
#
# Ships with the token moderation plugin, which grants moderator rights from a
# JWT claim and can post room events to an HTTP endpoint. Remove it if you do
# not use JWT authentication.
#
# Pin plugins to a commit, never to a branch. A plugin is written against a
# particular Prosody API and Prosody's keeps moving, so a URL ending in
# /master/ silently changes what you deploy. Re-check the pin whenever you
# change JITSI_VERSION.
PROSODY_PLUGINS=https://raw.githubusercontent.com/jesusdf/jitsi-token-moderation-plugin/997a93e9b079cd7d688ca12f81d181acc193b373/mod_token_moderation.lua

# Modules to enable on the MUC component, comma-separated. Must match the
# plugins above.
XMPP_MUC_MODULES=token_moderation


# -----------------------------------------------------------------------------
# Room event notifications
# -----------------------------------------------------------------------------
# An optional feature of the token moderation plugin: post room lifecycle
# events to an HTTP endpoint.
#
# Leave NOTIFICATION_URL empty and the whole section is skipped -- no
# configuration is written and the plugin logs that notifications are off. The
# remaining values are then ignored, and blank ones fall back to the defaults
# shown here rather than producing a broken configuration.

NOTIFICATION_URL=
NOTIFICATION_USER=
NOTIFICATION_PASSWORD=
NOTIFICATION_USERAGENT=Jitsi-Prosody
NOTIFICATION_TIMEOUT=10
NOTIFICATION_RETRY_COUNT=5
NOTIFICATION_RETRY_DELAY=1


# -----------------------------------------------------------------------------
# Optional services
# -----------------------------------------------------------------------------
# Comma-separated list of optional services to run. Empty means none, which is
# the default. Docker Compose reads this variable itself, so turning a service
# on is a configuration change and not a different command line -- which is
# what makes it work from Portainer.
#
#   jigasi   SIP gateway and transcription (see below)
COMPOSE_PROFILES=


# -----------------------------------------------------------------------------
# SIP gateway and transcription (jigasi)
# -----------------------------------------------------------------------------
# Only used when COMPOSE_PROFILES includes "jigasi". Two independent features
# live in this one service; enable either, both or neither.
#
# The XMPP account it needs is created automatically by the Prosody container,
# exactly like the bridge's: set the password below and run
# scripts/gen-secrets.sh. Nothing else to provision.

JIGASI_XMPP_USER=jigasi
JIGASI_XMPP_PASSWORD=
JIGASI_BREWERY_MUC=jigasibrewery

# Media ports for SIP calls. Must be reachable from the SIP provider.
JIGASI_PORT_MIN=20000
JIGASI_PORT_MAX=20050

# --- Telephony ---------------------------------------------------------------
# Dial in from a phone, and dial out from a conference. This needs an account
# with a SIP provider or your own PBX: a gateway is by definition a bridge to
# something outside, so this part cannot be self-contained. Leave empty to run
# jigasi for transcription only.
JIGASI_SIP_URI=
JIGASI_SIP_PASSWORD=
JIGASI_SIP_SERVER=
JIGASI_SIP_PORT=5060
JIGASI_SIP_TRANSPORT=UDP

# --- Transcription -----------------------------------------------------------
# Subtitles and saved transcripts. Unlike telephony, this can be fully
# self-hosted: point JIGASI_TRANSCRIBER_VOSK_URL at your own Vosk server and
# JIGASI_TRANSCRIBER_LIBRETRANSLATE_URL at your own LibreTranslate, and no
# audio leaves the deployment.
#
# The transcriber joins conferences as a hidden participant and needs its own
# XMPP account. Prosody creates it when ENABLE_TRANSCRIPTIONS=1 and the
# password below is set.
ENABLE_TRANSCRIPTIONS=0
JIGASI_TRANSCRIBER_USER=transcriber
JIGASI_TRANSCRIBER_PASSWORD=

# ws://vosk:2700 when running a Vosk container alongside this stack.
JIGASI_TRANSCRIBER_VOSK_URL=

# Write transcripts to the transcripts volume, which the web container serves.
JIGASI_TRANSCRIBER_ENABLE_SAVING=0

# Live translation, off by default. Needs LIBRETRANSLATE_URL when on.
JIGASI_TRANSCRIBER_ENABLE_TRANSLATION=0
JIGASI_TRANSCRIBER_LIBRETRANSLATE_URL=


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt

JWT_APP_ID=
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=
JWT_ACCEPTED_AUDIENCES=
JWT_ALLOW_EMPTY=0
JWT_TOKEN_AUTH_MODULE=token_verification

# Refuse to promote a participant to moderator unless their token says so.
# Without it, whoever arrives first in an empty room becomes moderator.
REQUIRE_TOKEN_FOR_MODERATION=1


# -----------------------------------------------------------------------------
# XMPP
# -----------------------------------------------------------------------------
# Internal domains. XMPP_DOMAIN is what JWT tokens declare, so changing it
# invalidates every issued token.

XMPP_DOMAIN=meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi

# Filled by scripts/gen-secrets.sh
JICOFO_COMPONENT_SECRET=
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=


# -----------------------------------------------------------------------------
# Media
# -----------------------------------------------------------------------------

# Address of the Docker host on its local network.
DOCKER_HOST_ADDRESS=

# Public address advertised to clients. Leave empty to discover it over STUN.
JVB_ADVERTISE_IPS=

JVB_PORT=10000
JVB_BREWERY_MUC=jvbbrewery
JVB_WS_SERVER_ID=jvb

# The stack's own TURN server doubles as the STUN server, so the deployment
# does not depend on any external service.
JVB_STUN_SERVERS=

ENABLE_COLIBRI_WEBSOCKET=1
ENABLE_XMPP_WEBSOCKET=1
ENABLE_SCTP=0


# -----------------------------------------------------------------------------
# TURN
# -----------------------------------------------------------------------------

# Secret shared by coturn and Prosody. Prosody turns it into time-limited
# credentials, so clients never see a static password. Prosody reads it from
# its environment, which is why it is a literal here rather than something the
# stack generates at startup. Run scripts/gen-secrets.sh to rotate it.
# Leave empty to run without a TURN server.
TURN_CREDENTIALS=

# Hostname clients use to reach the TURN server, and the realm coturn
# advertises. Usually the primary domain, because the certificate has to match.
TURN_HOST=meet.example.org
TURNS_HOST=meet.example.org
TURN_PORT=443
TURNS_PORT=443

# Public address of the TURN server. Leave empty to reuse JVB_ADVERTISE_IPS.
TURN_EXTERNAL_IP=

# Relay port range. These ports face the video bridge, never the client, so
# they do not need to be reachable from the internet.
TURN_RELAY_MIN_PORT=49152
TURN_RELAY_MAX_PORT=49252

# Name of the shared Docker network other stacks join so nginx can proxy to
# their containers without publishing any port on the host. This stack creates
# it; the others declare it as external. See docs/deployment.md, chapter 5.
EDGE_NETWORK=jitsi-edge

# Subnet of the stack's own Docker network. Pinned rather than left to Docker
# because coturn's peer allow-list has to name it exactly. Change it only if it
# collides with something else on the host.
STACK_SUBNET=172.31.250.0/24


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------

ENABLE_LOBBY=0
ENABLE_PREJOIN_PAGE=0
ENABLE_WELCOME_PAGE=1
ENABLE_CLOSE_PAGE=1
ENABLE_IPV6=0
ENABLE_RECORDING=0


# -----------------------------------------------------------------------------
# Internal -- do not change
# -----------------------------------------------------------------------------
# The stack's nginx terminates TLS, so the web container serves plain HTTP and
# never issues certificates of its own.

DISABLE_HTTPS=1
ENABLE_HSTS=0
ENABLE_LETSENCRYPT=0

# Directory the bind mounts resolve against. "." means next to this compose
# file, which is right for a normal checkout.
#
# Set it to an absolute host path when the Docker daemon cannot see the
# directory the compose file lives in -- which is the case for a Portainer
# stack deployed from a Git repository, unless Portainer is configured with a
# local filesystem path for relative volumes. See docs/deployment.md.
STACK_DIR=.

# Where the Jitsi images keep their generated configuration.
CONFIG=./data
