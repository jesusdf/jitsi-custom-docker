private/

# Live configuration. Only the *.example counterparts are versioned.
.env
/data/
/conf/routes.conf
/conf/certs/*
!/conf/certs/.gitkeep
/conf/branding/*
!/conf/branding/.gitkeep
/conf/nginx/sites/*
!/conf/nginx/sites/*.example
/conf/nginx/www/*
!/conf/nginx/www/.gitkeep
/conf/prosody/plugins/*
!/conf/prosody/plugins/.gitkeep
